{
  "name": "am-skills",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "am-skills-mcp": "./mcp-server/main.mjs"
  },
  "files": [
    "mcp-server",
    "skills",
    "skills-registry.json",
    "tools/lib/skills-fs.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node tools/validate-skills.mjs",
    "generate:registry": "node tools/generate-registry.mjs",
    "generate:catalog": "node tools/generate-catalog.mjs",
    "scaffold": "node tools/skill-plugin/generate-skill.mjs",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector node mcp-server/main.mjs",
    "mcp:inspect:crm-example": "npx -y @modelcontextprotocol/inspector node examples/mock-crm-mcp/main.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fuse.js": "^7.5.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3"
  }
}
